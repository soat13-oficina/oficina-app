# Variáveis NÃO sensíveis da aplicação em homologação.
#
# A pipeline ACRESCENTA duas linhas a este arquivo antes do apply, porque só
# são conhecidas em tempo de deploy:
#   DB_URL              endpoint do RDS oficina-db-hml, descoberto via AWS CLI
#   AWS_SES_REMETENTE   variable de repositório AWS_SES_REMETENTE
#
# Credenciais (DB_USER/DB_PASS, JWT_SECRET) NÃO passam por aqui: vêm dos
# Secrets criados pela pipeline a partir do Secrets Manager.

# SMTP local/demo (Mailhog). Válido apenas para desenvolvimento local via
# docker-compose.yml; em nuvem o envio usa o profile "ses".
SMTP_HOST=localhost
SMTP_PORT=1025

AWS_SES_REGION=us-east-1

# --- Observabilidade (Datadog) ------------------------------------------------
# Carrega o dd-java-agent embarcado na imagem. Sobrescreve o JAVA_OPTS definido no
# Dockerfile, por isso o MaxRAMPercentage precisa ser repetido aqui - omiti-lo faria a
# JVM voltar ao heap default e ignorar o limite de memoria do container.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -javaagent:/app/dd-java-agent.jar

# Saga (ADR 0004): prazos curtos de decisao do cliente e de pagamento para a demonstracao em
# homologacao. Em producao a decisao fica vazia (vale a validade do orcamento) e o pagamento e 24 h.
SAGA_PRAZO_DECISAO=PT15M
SAGA_PRAZO_PAGAMENTO=PT30M

# env do unified service tagging: separa hml de producao em APM, logs e metricas.
DD_ENV=hml
# Mesma separacao do lado das metricas de negocio (tag comum "ambiente").
AMBIENTE=hml

# Mensageria da Saga (ADR 0005, docs/arquitetura/mensageria-local.md). O Billing e outro servico:
# billing-commands e execution-commands saem pelo SQS e as respostas chegam em os-saga-replies (filas
# oficina-hml-<fila>.fifo; credenciais pela Role IRSA).
MENSAGERIA_SQS_HABILITADO=true
MENSAGERIA_SQS_ENVIO=billing-commands,execution-commands
MENSAGERIA_SQS_CONSUMO=os-saga-replies

# DD_VERSION e acrescentado pela pipeline junto de DB_URL: e a tag da imagem, so
# conhecida em tempo de deploy.

# Cadastro de pecas (Execution): conferido na abertura da OS por REST interno, pelo DNS do cluster,
# com o X-Service-Token.
CATALOGO_PECAS_URL=http://oficina-execution-service:8080
