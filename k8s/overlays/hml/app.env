# Variáveis NÃO sensíveis da aplicação em homologação.
#
# A pipeline ACRESCENTA duas linhas a este arquivo antes do apply, porque só
# são conhecidas em tempo de deploy:
#   DB_URL              endpoint do RDS oficina-db-hml, descoberto via AWS CLI
#   AWS_SES_REMETENTE   variable de repositório AWS_SES_REMETENTE
#
# Credenciais (DB_USER/DB_PASS, JWT_SECRET) NÃO passam por aqui: vêm dos
# Secrets criados pela pipeline a partir do Secrets Manager.

# SMTP local/demo (Mailhog). Válido apenas para desenvolvimento local via
# docker-compose.yml; em nuvem o envio usa o profile "ses".
SMTP_HOST=localhost
SMTP_PORT=1025

AWS_SES_REGION=us-east-1
